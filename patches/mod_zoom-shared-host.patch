# mod_zoom shared-host patch (BTI LMS)
#
# Location: moodle/patches/mod_zoom-shared-host.patch
# (kept next to the Moodle Docker stack — apply against moodle/public/mod/zoom)
#
# WHY THIS EXISTS
# ---------------
# Upstream mod_zoom (v5.5.0) requires every Moodle user who creates a Zoom
# activity to have their own licensed Zoom account (matched by email). BTI LMS
# uses a single shared Zoom host (brianmbogo03@gmail.com) for all meetings so
# instructors do not each need Zoom licenses.
#
# This patch adds admin setting zoom/sharedhostemail. When set, meeting
# creation/update/recreate always host under that Zoom user. view.php still
# uses zoom_get_user_id() so Start vs Join is not incorrectly granted to
# every logged-in user.
#
# REAPPLY ON PLUGIN UPGRADES
# --------------------------
# Copying a fresh mod_zoom release into moodle/public/mod/zoom will wipe these
# edits. After any upgrade, re-apply this patch (or re-merge the equivalent
# changes) and confirm zoom/sharedhostemail is still set in site config.
#
# Files touched:
#   mod/zoom/locallib.php
#   mod/zoom/mod_form.php
#   mod/zoom/recreate.php
#   mod/zoom/lib.php
#   mod/zoom/settings.php
#   mod/zoom/lang/en/zoom.php
#
# Error behaviour when shared host is missing:
#   Instructor sees zoomerr_sharedhostnotfound — a clear Moodle message naming
#   the configured email and pointing admins to Connection settings. No raw
#   Zoom API error is shown for this case.
#
--- a/mod/zoom/locallib.php
+++ b/mod/zoom/locallib.php
@@ -415,6 +415,78 @@ function zoom_get_user_id($required = true) {
     return $zoomuserid;
 }
 
+/**
+ * Shared Zoom host email from admin settings (empty = disabled).
+ *
+ * @return string|null
+ */
+function zoom_get_shared_host_email() {
+    $email = trim((string) get_config('zoom', 'sharedhostemail'));
+    return $email !== '' ? $email : null;
+}
+
+/**
+ * Zoom user ID to use as meeting host when creating/recreating meetings.
+ *
+ * If zoom/sharedhostemail is set, always use that account; otherwise the
+ * currently logged-in Moodle user (upstream behaviour).
+ *
+ * Intentionally separate from zoom_get_user_id() so view.php host checks
+ * still reflect the actual Moodle user.
+ *
+ * @param bool $required If true, throw if the host Zoom user is missing.
+ * @return string|false
+ */
+function zoom_get_meeting_host_user_id($required = true) {
+    $shared = zoom_get_shared_host_email();
+    if ($shared === null) {
+        return zoom_get_user_id($required);
+    }
+
+    $cache = cache::make('mod_zoom', 'zoomid');
+    $cachekey = 'sharedhost:' . strtolower($shared);
+    if (!($zoomuserid = $cache->get($cachekey))) {
+        $zoomuserid = false;
+        try {
+            $zoomuser = zoom_get_user($shared);
+            if ($zoomuser !== false && isset($zoomuser->id) && ($zoomuser->id !== false)) {
+                $zoomuserid = $zoomuser->id;
+                $cache->set($cachekey, $zoomuserid);
+            }
+            if ($required && $zoomuser === false) {
+                throw new moodle_exception('zoomerr_sharedhostnotfound', 'mod_zoom', '', $shared);
+            }
+        } catch (moodle_exception $error) {
+            if ($required) {
+                throw $error;
+            }
+        }
+    }
+
+    return $zoomuserid;
+}
+
+/**
+ * Apply the configured shared Zoom host to a meeting object, or throw clearly.
+ *
+ * @param stdClass $zoom Meeting data from the form / recreate flow.
+ * @return void
+ */
+function zoom_apply_shared_host(stdClass $zoom) {
+    $shared = zoom_get_shared_host_email();
+    if ($shared === null) {
+        return;
+    }
+
+    $shareduser = zoom_get_user($shared);
+    if ($shareduser === false || empty($shareduser->id)) {
+        throw new moodle_exception('zoomerr_sharedhostnotfound', 'mod_zoom', '', $shared);
+    }
+
+    $zoom->host_id = $shareduser->id;
+    $zoom->schedule_for = $shared;
+}
+
